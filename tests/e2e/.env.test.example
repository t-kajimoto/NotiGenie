# E2E テスト用の環境変数設定ファイル
# このファイルをコピーして .env.test にリネームし、実際の値を設定してください
# .env.test は .gitignore に追加済みなのでコミットされません

# Gemini API Key
# Google AI Studio (https://aistudio.google.com/) で取得
GEMINI_API_KEY=your-gemini-api-key-here

# Notion API Key
# Notion Integrations (https://www.notion.so/my-integrations) で取得
NOTION_API_KEY=your-notion-api-key-here

# Google Cloud 認証情報ファイルのパス（Firestore接続に必要）
# サービスアカウントキーの JSON ファイルへの絶対パスを指定
GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/google-credential.json

# Firestore データベースID（省略時は "(default)"）
FIRESTORE_DATABASE=chat-history
